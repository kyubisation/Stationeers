alias GasSensor d0
alias AirVent d1
alias Self db

alias OutputPressure r0
alias RoomPressure r1
alias RoomRatio r2
alias CurrentValue r3

define MaxOutputPressure 55000 # KPa
define Threshold 74.75

loop:
l OutputPressure Self PressureOutput

blt OutputPressure MaxOutputPressure activateFiltration
s Self Mode 0
j roomControl

activateFiltration:
s Self Mode 1

roomControl:

# Read current atmosphere details
l RoomPressure GasSensor Pressure
l RoomRatio GasSensor RatioNitrogen
mul CurrentValue RoomPressure RoomRatio

blt CurrentValue Threshold activateVent

s AirVent On 0
j loop

activateVent:
# Set Air Vent to outward mode
s AirVent Mode 0
s AirVent On 1
j loop