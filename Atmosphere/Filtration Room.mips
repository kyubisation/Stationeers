alias Self db
alias AirVent d0
alias GasSensor d1

alias CurrentPressure r0
alias NitrogenRatio r1
alias OxygenRatio r2
alias FiltarQuantity r3

define MaxPressure 100 # KPa
define TargetNitrogenRatio 0.75 # KPa
define TargetOxygenRatio 0.25 # KPa

loop:
l CurrentPressure GasSensor Pressure

bgt CurrentPressure MaxPressure activateVent

s AirVent On 0
j roomFilter

activateVent:
# Set Air Vent to inward mode
s AirVent Mode 1
s AirVent On 1

roomFilter:
ls FiltarQuantity Self 0 Quantity
beq FiltarQuantity 0 deactivateFiltration
ls FiltarQuantity Self 1 Quantity
beq FiltarQuantity 0 deactivateFiltration

l NitrogenRatio Self RatioNitrogenInput
bne NitrogenRatio TargetNitrogenRatio activateFiltration
l OxygenRatio Self RatioOxygenInput
bne OxygenRatio TargetOxygenRatio activateFiltration

deactivateFiltration:
s Self Mode 0
j loop

activateFiltration:
s Self Mode 1

j loop